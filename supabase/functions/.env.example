# System-level fallback keys. In production, set these as Supabase Edge Function
# Secrets. Department keys are stored encrypted in Supabase Vault.
GEMINI_API_KEY=replace-with-a-Google-AI-Studio-key
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=replace-with-an-OpenAI-project-key
OPENAI_MODEL=gpt-4.1-mini
# Optional custom prediction provider; credentials stay server-side and the
# endpoint receives only the anonymous projection built by aiPrivacy.ts.
APMS_AI_SERVICE_URL=
APMS_AI_SERVICE_API_KEY=
APMS_AI_SERVICE_MODEL=
APMS_AI_SERVICE_MODEL_VERSION=
# Machine-only token and immutable release pin for the inference worker.
# Configure these as Edge Function Secrets; never put them in browser config.
APMS_AI_ARTIFACT_TOKEN=
APMS_AI_ARTIFACT_BUCKET=apms-ai-artifacts
APMS_AI_ARTIFACT_PREFIX=
APMS_AI_ARTIFACT_MANIFEST_SHA256=
# Optional Cloudflare Access service token; configure both values together.
APMS_AI_CF_ACCESS_CLIENT_ID=
APMS_AI_CF_ACCESS_CLIENT_SECRET=
# Set true only for localhost HTTP development; production URLs must use HTTPS.
APMS_AI_ALLOW_INSECURE_HTTP=false
RESEND_API_KEY=replace-with-a-Resend-api-key
# Optional APMS scheduler token. The scheduled runner can instead authenticate
# with the service-role key already configured for Supabase Edge Functions.
BACKUP_SCHEDULER_TOKEN=
# Optional. When unset, scheduled backups are stored as JSON in the private bucket.
# When configured, scheduled backups are encrypted with this separate key.
BACKUP_ENCRYPTION_KEY=
# FEEDBACK_FROM_EMAIL is configured in System Admin > System Settings.
