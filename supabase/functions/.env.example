# System-level fallback keys. In production, set these as Supabase Edge Function
# Secrets. Department keys are stored encrypted in Supabase Vault.
GEMINI_API_KEY=replace-with-a-Google-AI-Studio-key
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=replace-with-an-OpenAI-project-key
OPENAI_MODEL=gpt-4.1-mini
# Optional custom prediction provider; credentials stay server-side and the
# endpoint receives only the anonymous projection built by aiPrivacy.ts.
APMS_AI_SERVICE_URL=
APMS_AI_SERVICE_API_KEY=
APMS_AI_SERVICE_MODEL=
RESEND_API_KEY=replace-with-a-Resend-api-key
# FEEDBACK_FROM_EMAIL is configured in System Admin > System Settings.
