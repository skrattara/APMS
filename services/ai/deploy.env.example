# Copy to services/ai/.env.deploy (ignored) and set values for this machine.
# Generate a unique token; this placeholder is not a deployment credential.
APMS_AI_SERVICE_API_KEY=replace-with-a-generated-server-only-token
APMS_MODEL_HOST_PATH=C:/apms/APMS/services/ai/artifacts/selected-calibrated
APMS_AI_HOST_PORT=8080
APMS_AI_ENABLE_SYNTHETIC_DEMO=false
APMS_AI_THREADS=2
APMS_AI_MAX_CONCURRENT_REQUESTS=2
APMS_AI_MAX_REQUEST_BYTES=1048576
