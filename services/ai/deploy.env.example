# Copy to .env.deploy; never commit that private copy.
APMS_MODEL_HOST_PATH=C:/absolute/path/to/verified-model-bundle
APMS_AI_SERVICE_API_KEY=replace-with-a-random-server-only-token
APMS_AI_HOST_PORT=8080
APMS_AI_ENABLE_SYNTHETIC_DEMO=false
APMS_AI_THREADS=1
APMS_AI_MAX_REQUEST_BYTES=1048576
APMS_AI_MAX_CONCURRENT_REQUESTS=2

# Dockerfile defaults to torch 2.7.1+cpu for Python 3.12. For a release, compare
# the source bundle runtime_versions.torch and build arg TORCH_CPU_VERSION; this
# image labels its target Torch version. A differing PyTorch version has no
# checkpoint-parity guarantee, so smoke-test the exact image before release.
# docker build --build-arg TORCH_CPU_VERSION=<matching-cpu-wheel> ...

# For compose.keyfile.yaml, clear APMS_AI_SERVICE_API_KEY above and set:
# APMS_AI_KEY_HOST_PATH=C:/absolute/path/to/service-key.txt

# For compose.cloudflare.yaml, point DNS ingress at http://ai:8080 in the
# Cloudflare dashboard and set a pinned image and token file. The current
# Cloudflare-published tag supports --token-file (introduced in 2025.4.0).
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.10.1
# APMS_CF_TUNNEL_TOKEN_HOST_PATH=C:/absolute/path/to/cloudflare-token.txt
