{
  "id": "grading-system-it-global",
  "name": "IT Global Grading System",
  "description": "Cumulative module-based semester grading system. EL contributes 55% of the semester grade and MG contributes 45%. Periods cover configurable ranges of modules and are cumulative. EL is evaluated per module. MG consists of WuQ and PG, where PG consists of CiG and FO. If only one CiG assessment exists, the PG weighting changes from 65/35 to 50/50.",
  "periods": [
    {
      "id": "p1",
      "name": "P1",
      "sequence": 1,
      "groupIds": [
        "m1",
        "m2",
        "m3",
        "m4"
      ]
    },
    {
      "id": "p2",
      "name": "P2",
      "sequence": 2,
      "groupIds": [
        "m5",
        "m6",
        "m7",
        "m8",
        "m9"
      ]
    },
    {
      "id": "p3",
      "name": "P3",
      "sequence": 3,
      "groupIds": [
        "m10",
        "m11",
        "m12",
        "m13",
        "m14"
      ]
    }
  ],
  "groupTypes": [
    {
      "id": "module",
      "name": "Module",
      "description": "Instructional module. The number of modules in a semester is configurable and is not fixed at 14."
    }
  ],
  "groups": [
    {
      "id": "m1",
      "name": "Module 1",
      "typeId": "module",
      "sequence": 1
    },
    {
      "id": "m2",
      "name": "Module 2",
      "typeId": "module",
      "sequence": 2
    },
    {
      "id": "m3",
      "name": "Module 3",
      "typeId": "module",
      "sequence": 3
    },
    {
      "id": "m4",
      "name": "Module 4",
      "typeId": "module",
      "sequence": 4
    },
    {
      "id": "m5",
      "name": "Module 5",
      "typeId": "module",
      "sequence": 5
    },
    {
      "id": "m6",
      "name": "Module 6",
      "typeId": "module",
      "sequence": 6
    },
    {
      "id": "m7",
      "name": "Module 7",
      "typeId": "module",
      "sequence": 7
    },
    {
      "id": "m8",
      "name": "Module 8",
      "typeId": "module",
      "sequence": 8
    },
    {
      "id": "m9",
      "name": "Module 9",
      "typeId": "module",
      "sequence": 9
    },
    {
      "id": "m10",
      "name": "Module 10",
      "typeId": "module",
      "sequence": 10
    },
    {
      "id": "m11",
      "name": "Module 11",
      "typeId": "module",
      "sequence": 11
    },
    {
      "id": "m12",
      "name": "Module 12",
      "typeId": "module",
      "sequence": 12
    },
    {
      "id": "m13",
      "name": "Module 13",
      "typeId": "module",
      "sequence": 13
    },
    {
      "id": "m14",
      "name": "Module 14",
      "typeId": "module",
      "sequence": 14
    }
  ],
  "assessmentTypes": [
    {
      "id": "soc",
      "name": "Start of Class",
      "description": "Binary attendance/presence assessment. P = Present = 100%; A = Absent = 0%.",
      "shortCode": "SoC"
    },
    {
      "id": "lp",
      "name": "Let's Practice",
      "description": "Module assessment scored from 0 to 3 and mapped to 0%, 60%, 80%, and 100%.",
      "shortCode": "LP"
    },
    {
      "id": "tb",
      "name": "Reflection",
      "description": "Module assessment scored from 0 to 3 and mapped to 0%, 60%, 80%, and 100%."
    },
    {
      "id": "wuq",
      "name": "Wrap-Up Quiz",
      "description": "One assessment per module, scored linearly from 0 to 100%.",
      "shortCode": "WuQ"
    },
    {
      "id": "cig",
      "name": "Check-in Grade",
      "description": "Semester-level assessment type. Between one and four assessments are allowed and scores are mapped linearly from 0 to 100%.",
      "shortCode": "CiG"
    },
    {
      "id": "fo",
      "name": "FO",
      "description": "One semester-level assessment scored linearly from 0 to 100%.",
      "shortCode": "FO"
    }
  ],
  "components": [
    {
      "id": "soc",
      "name": "Start of Class",
      "sequence": 1,
      "description": "Two binary SoC assessments are required per module.",
      "assessmentDefinition": {
        "typeId": "soc",
        "count": {
          "min": 2,
          "max": 2,
          "scope": {
            "type": "per_group",
            "groupTypeId": "module"
          }
        },
        "scoring": {
          "mode": "value_mapping",
          "mapping": [
            {
              "value": "P",
              "percentage": 100
            },
            {
              "value": "A",
              "percentage": 0
            }
          ]
        },
        "aggregation": {
          "mode": "equal"
        }
      },
      "calculation": {
        "mode": "assessments"
      },
      "shortCode": "SoC"
    },
    {
      "id": "lp",
      "name": "Let's Practice",
      "sequence": 2,
      "description": "One or two LP assessments are allowed per module. Each assessment has a maximum raw score of 3.",
      "assessmentDefinition": {
        "typeId": "lp",
        "count": {
          "min": 1,
          "max": 2,
          "scope": {
            "type": "per_group",
            "groupTypeId": "module"
          }
        },
        "maxScore": 3,
        "scoring": {
          "mode": "numeric_mapping",
          "mapping": [
            {
              "value": 0,
              "percentage": 0
            },
            {
              "value": 1,
              "percentage": 60
            },
            {
              "value": 2,
              "percentage": 80
            },
            {
              "value": 3,
              "percentage": 100
            }
          ]
        },
        "aggregation": {
          "mode": "equal"
        }
      },
      "calculation": {
        "mode": "assessments"
      },
      "shortCode": "LP"
    },
    {
      "id": "tb",
      "name": "Reflection",
      "sequence": 3,
      "description": "Exactly one TB assessment is required per module. The maximum raw score is 3.",
      "assessmentDefinition": {
        "typeId": "tb",
        "count": {
          "min": 1,
          "max": 1,
          "scope": {
            "type": "per_group",
            "groupTypeId": "module"
          }
        },
        "maxScore": 3,
        "scoring": {
          "mode": "numeric_mapping",
          "mapping": [
            {
              "value": 0,
              "percentage": 0
            },
            {
              "value": 1,
              "percentage": 60
            },
            {
              "value": 2,
              "percentage": 80
            },
            {
              "value": 3,
              "percentage": 100
            }
          ]
        },
        "aggregation": {
          "mode": "equal"
        }
      },
      "calculation": {
        "mode": "assessments"
      },
      "shortCode": "TB"
    },
    {
      "id": "el",
      "name": "Effortful Learning",
      "sequence": 4,
      "description": "EL contributes 55% of the semester grade. Internally, SoC, LP, and TB contribute 5, 35, and 15 percentage points respectively. These are normalized to 1/11, 7/11, and 3/11 within EL.",
      "calculation": {
        "mode": "weighted",
        "weightMode": "relative",
        "components": [
          {
            "source": "component",
            "componentId": "soc",
            "weight": {
              "numerator": 1,
              "denominator": 11
            }
          },
          {
            "source": "component",
            "componentId": "lp",
            "weight": {
              "numerator": 7,
              "denominator": 11
            }
          },
          {
            "source": "component",
            "componentId": "tb",
            "weight": {
              "numerator": 3,
              "denominator": 11
            }
          }
        ]
      },
      "shortCode": "EL"
    },
    {
      "id": "wuq",
      "name": "Wrap-Up Quiz",
      "sequence": 5,
      "description": "Exactly one WuQ assessment is required per module and is scored linearly.",
      "assessmentDefinition": {
        "typeId": "wuq",
        "count": {
          "min": 1,
          "max": 1,
          "scope": {
            "type": "per_group",
            "groupTypeId": "module"
          }
        },
        "maxScore": 100,
        "scoring": {
          "mode": "linear"
        },
        "aggregation": {
          "mode": "equal"
        }
      },
      "calculation": {
        "mode": "assessments"
      },
      "shortCode": "WuQ"
    },
    {
      "id": "cig",
      "name": "Project Check-In",
      "sequence": 6,
      "description": "Between one and four CiG assessments are allowed for the semester.",
      "assessmentDefinition": {
        "typeId": "cig",
        "count": {
          "min": 1,
          "max": 4,
          "scope": {
            "type": "overall"
          }
        },
        "maxScore": 100,
        "scoring": {
          "mode": "linear"
        },
        "aggregation": {
          "mode": "equal"
        }
      },
      "calculation": {
        "mode": "assessments"
      },
      "shortCode": "CiG"
    },
    {
      "id": "fo",
      "name": "Final Output",
      "sequence": 7,
      "description": "Exactly one FO assessment is required for the semester.",
      "assessmentDefinition": {
        "typeId": "fo",
        "count": {
          "min": 1,
          "max": 1,
          "scope": {
            "type": "overall"
          }
        },
        "maxScore": 100,
        "scoring": {
          "mode": "linear"
        },
        "aggregation": {
          "mode": "equal"
        }
      },
      "calculation": {
        "mode": "assessments"
      },
      "shortCode": "FO"
    },
    {
      "id": "pg",
      "name": "Project Grade",
      "sequence": 8,
      "description": "PG normally consists of 65% CiG and 35% FO. If exactly one CiG assessment exists, the weighting changes to 50% CiG and 50% FO.",
      "calculation": {
        "mode": "weighted",
        "weightMode": "relative",
        "components": [
          {
            "source": "component",
            "componentId": "cig",
            "weight": 0.65
          },
          {
            "source": "component",
            "componentId": "fo",
            "weight": 0.35
          }
        ],
        "rules": [
          {
            "when": {
              "type": "assessment_count",
              "componentId": "cig",
              "operator": "eq",
              "value": 1
            },
            "override": {
              "components": [
                {
                  "source": "component",
                  "componentId": "cig",
                  "weight": 0.5
                },
                {
                  "source": "component",
                  "componentId": "fo",
                  "weight": 0.5
                }
              ]
            }
          }
        ]
      },
      "shortCode": "PG"
    },
    {
      "id": "mg",
      "name": "Mastery Grade",
      "sequence": 9,
      "description": "MG contributes 45% of the semester grade. WuQ contributes 15 percentage points and PG contributes 30 percentage points, normalized within MG to 1/3 and 2/3.",
      "calculation": {
        "mode": "weighted",
        "weightMode": "relative",
        "components": [
          {
            "source": "component",
            "componentId": "wuq",
            "weight": {
              "numerator": 1,
              "denominator": 3
            }
          },
          {
            "source": "component",
            "componentId": "pg",
            "weight": {
              "numerator": 2,
              "denominator": 3
            }
          }
        ]
      },
      "shortCode": "MG"
    },
    {
      "id": "semester-grade",
      "name": "Final Semester Grade",
      "sequence": 10,
      "description": "Combines EL at 55% and MG at 45%.",
      "calculation": {
        "mode": "weighted",
        "weightMode": "relative",
        "components": [
          {
            "source": "component",
            "componentId": "el",
            "weight": 0.55
          },
          {
            "source": "component",
            "componentId": "mg",
            "weight": 0.45
          }
        ]
      },
      "shortCode": "FG"
    }
  ],
  "calculationRootComponentId": "semester-grade",
  "periodCalculation": {
    "mode": "cumulative",
    "scope": "groups",
    "groupTypeId": "module",
    "finalPeriodId": "p3"
  },
  "finalResult": {
    "source": "component",
    "componentId": "semester-grade"
  },
  "finalGradeConversion": {
    "passingPercentage": 80,
    "passingScale": {
      "mode": "equal_interval",
      "maximumPercentage": 100,
      "bestPoint": 1,
      "passingPoint": 3,
      "pointInterval": 0.25
    },
    "failingScale": {
      "mode": "equal_interval",
      "minimumPercentage": 0,
      "firstFailingPoint": 3.25,
      "worstPoint": 5,
      "pointInterval": 0.25
    },
    "rounding": {
      "mode": "nearest",
      "precision": 2
    }
  }
}
